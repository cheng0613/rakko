{
  "name": "@rakko/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./postgres-store": {
      "types": "./dist/postgres-store.d.ts",
      "import": "./dist/postgres-store.js"
    }
  },
  "dependencies": {
    "@rakko/core": "workspace:^",
    "@rakko/db": "workspace:^",
    "@rakko/protocol": "workspace:^",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.1",
    "zod": "^4.1.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test \"dist/**/*.test.js\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "node --input-type=module -e \"import('@rakko/db').then(async (m) => { const h = m.createDb(process.env.DATABASE_URL); await m.migrateDb(h); console.log('迁移已应用'); await h.close(); })\""
  }
}
