{
  "name": "rakko",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter @rakko/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "e2e:pi": "tsx scripts/e2e-pi-host.ts",
    "e2e:provider": "tsx scripts/e2e-provider.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
