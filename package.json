{
  "name": "rakko",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev --parallel",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "task": "node scripts/task-run.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "turbo": "^2.6.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "@rakko/core": "workspace:^",
    "@rakko/db": "workspace:^",
    "@rakko/server": "workspace:^"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  }
}
