# 本地开发用；没有 DATABASE_URL 时服务端自动退回内存实现。
DATABASE_URL=postgres://rakko:rakko@127.0.0.1:5433/rakko

# 本地单用户模式：首次启动自动建这个账号（默认 local@rakko.app）
RAKKO_USER_EMAIL=local@rakko.app
# free | pro | team —— 决定每周运行次数上限（30 / 120 / 600）
RAKKO_PLAN=pro

# 模型网关：任何 OpenAI 兼容 /chat/completions 都能用。
# 没有 RAKKO_API_KEY 时服务端用假 provider，链路照样能跑通。
RAKKO_BASE_URL=https://tokenhub.tencentmaas.com/v1
RAKKO_API_KEY=
# 标准档与快档；配额用超了、或标准档熔断/报错时自动降到快档
RAKKO_MODEL_STANDARD=deepseek-v4-pro
RAKKO_MODEL_FAST=deepseek/deepseek-flash
# 单次请求总超时 / 首字超时（模型会先思考很久，别设太小）
RAKKO_TIMEOUT_MS=180000
RAKKO_FIRST_CHUNK_MS=45000

PORT=8787
HOST=127.0.0.1
DB_POOL=10

# 智能体与工具
# 沙箱根目录：文件工具只能读写这里面的东西
RAKKO_WORKSPACE=
# shell 工具默认超时
RAKKO_SHELL_TIMEOUT_MS=20000
# 审批等多久自动拒绝（毫秒）
RAKKO_APPROVAL_TIMEOUT_MS=600000
# 一个运行最多几轮「模型 → 工具」
RAKKO_MAX_STEPS=6
